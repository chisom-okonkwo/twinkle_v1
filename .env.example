# Public client configuration. Never put service_role, sb_secret_, database
# passwords, access tokens, or OpenAI keys in this app's environment.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional public EAS project UUID (required for remote push in a development build).
# EXPO_PUBLIC_EAS_PROJECT_ID=
# Build-time identifiers, chosen when linking your EAS/Firebase app.
# TWINKLE_ANDROID_PACKAGE=
# TWINKLE_IOS_BUNDLE_ID=
# GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json
# FCM service-account credentials belong in EAS credentials, never in Expo variables.
